# RCA Pilot 环境变量示例
# 复制为 .env 后修改
# prod 环境启动时会 fail-fast 校验：JWT_SECRET / POSTGRES_PASSWORD 不得为默认值，SERVICE_API_KEY 必须配置

# ---- 环境 ----
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---- 数据库 ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rca
POSTGRES_PASSWORD=rca-secret
POSTGRES_DB=rca_pilot

# ---- Redis（jti 黑名单 + 限流共享存储；不可用时自动降级）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ---- JWT ----
JWT_SECRET=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# MFA：TOTP 校验尚未实现，保持 false（实现后再开启，避免声明与实现不符）
MFA_REQUIRED=false
# 登录连续失败锁定时间窗（分钟，0=永久锁定）
ACCOUNT_LOCKOUT_MINUTES=15

# ---- 服务间调用 ----
# gate3 自动重试内部触发、connector 鉴权依赖此密钥；prod 必填
SERVICE_API_KEY=
# 仅当部署在可信反向代理（Nginx）之后才设为 true —— 影响限流 IP 与审计 IP 的取值
TRUST_PROXY_HEADERS=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---- 服务端口 ----
AUTH_SERVICE_PORT=8001
CASE_SERVICE_PORT=8002
EVIDENCE_SERVICE_PORT=8003
AGENT_SERVICE_PORT=8004
AUDIT_SERVICE_PORT=8005
LMS_CONNECTOR_PORT=8011

# ---- GxP 合规 ----
AUDIT_LOG_IMMUTABLE=true
SESSION_TIMEOUT_MINUTES=15
REQUIRE_DUAL_SIGNATURE=true
RETENTION_YEARS=10

# ---- LLM (Phase 2 启用) ----
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
# Drafter 整篇 ICH Q9 报告的输出上限（大于全局 LLM_MAX_TOKENS）
LLM_MAX_TOKENS_DRAFTER=4096

# ---- 可观测性（Phase 2b）----
SENTRY_DSN=
PROMETHEUS_ENABLED=true
UNLEASH_URL=

# ---- Feature Flag（Phase 2c 灰度发布）----
# JSON 格式覆盖默认 flag，如 {"skeptic_v2_enhanced":{"enabled":true,"rollout_percentage":10}}
RCA_FEATURE_FLAGS=
RCA_FEATURE_FLAGS_FILE=

# ---- 镜像版本（CD 注入；本地 compose build 时忽略）----
RCA_IMAGE_TAG=dev

# ---- 数据库备份（db-backup 服务）----
BACKUP_RETENTION_DAYS=30
