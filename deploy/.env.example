# RCA Pilot 环境变量示例
# 复制为 .env 后修改

# ---- 环境 ----
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---- 数据库 ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rca
POSTGRES_PASSWORD=rca-secret
POSTGRES_DB=rca_pilot

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
MFA_REQUIRED=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---- 服务端口 ----
AUTH_SERVICE_PORT=8001
CASE_SERVICE_PORT=8002
EVIDENCE_SERVICE_PORT=8003
AGENT_SERVICE_PORT=8004
AUDIT_SERVICE_PORT=8005
LMS_CONNECTOR_PORT=8011

# ---- GxP 合规 ----
AUDIT_LOG_IMMUTABLE=true
SESSION_TIMEOUT_MINUTES=15
REQUIRE_DUAL_SIGNATURE=true
RETENTION_YEARS=10

# ---- LLM (Phase 2 启用) ----
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ---- 可观测性（Phase 2b）----
SENTRY_DSN=
PROMETHEUS_ENABLED=true
UNLEASH_URL=

# ---- Feature Flag（Phase 2c 灰度发布）----
# JSON 格式覆盖默认 flag，如 {"skeptic_v2_enhanced":{"enabled":true,"rollout_percentage":10}}
RCA_FEATURE_FLAGS=
RCA_FEATURE_FLAGS_FILE=
